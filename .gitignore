.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.db
credentials*
secrets*

# Public templates are tracked; signed acceptance and active agent config stay local.
config/site_acceptance.yaml
agent_workspace/openclaw.json

# Runtime recordings and transfer archives.
*.bag
*.db3
*.mcap
*.tar
*.tar.gz
*.zip
