Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.85
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Mass Properties:
        Inertia: false
        Mass: false
      Name: Current Robot State
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
      Value: true
    - Alpha: 0.65
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /adaptive_grasp/target_robot_description
      Enabled: true
      Mass Properties:
        Inertia: false
        Mass: false
      Name: IK Target Ghost
      TF Prefix: "grasp_target"
      Update Interval: 0
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: false
        Link_Camera_Head_Forehead:
          Value: false
        Link_Zero_Point:
          Value: false
        rgbd_head_color_optical_frame:
          Value: true
      Marker Scale: 0.25
      Name: RGBD Optical Frame Axes
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        Link_Zero_Point:
          Link_Camera_Head_Forehead:
            rgbd_head_color_optical_frame:
              {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Value: /adaptive_grasp/grasp_markers
      Name: Grasp Candidates
      Namespaces:
        best_grasp: true
        grasp_candidate: true
        selected_object: true
      Queue Size: 2
      Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /adaptive_grasp/visualization_image
      Name: Image
      Queue Size: 2
      Transport Hint: raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: Link_Zero_Point
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.6
      Name: Current View
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Yaw: 0.9
Window Geometry:
  Height: 900
  Width: 1400
